# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/emergency_callback_go?sslmode=disable
DB_POOL_MAX_CONNS=100
DB_POOL_MIN_CONNS=10

# Server
HTTP_ADDR=:8000
SITE_DOMAIN=http://103tezjardem.uz
SESSION_SECRET=replace-with-32-random-bytes
CSRF_KEY=replace-with-32-random-bytes
# HTTPS ortida true qiling (cookie faqat TLS orqali yuboriladi)
COOKIE_SECURE=false

# Telephony backend: ami (klassik, dialplan kerak) | ari (dialplan kerak emas)
TELEPHONY_BACKEND=ami

# Asterisk AMI (backend=ami uchun majburiy)
AMI_HOST=172.16.95.250
AMI_PORT=5038
AMI_USERNAME=srtapi_amidefault
AMI_SECRET=amidefault
AMI_CALLER_ID=781138081
AMI_OPERATOR_QUEUE=777
AMI_CALL_TIMEOUT=60
AMI_RATING_RETRY_LIMIT=3
AMI_RATING_TIMEOUT=10

# Asterisk ARI (backend=ari uchun majburiy)
# ARI_URL=http://172.16.95.250:8088/ari
# ARI_USERNAME=ecb
# ARI_PASSWORD=

# Audio
# WAV fayllar joyi (ilova serverida)
AUDIO_DIR=audios
# res_http_media_cache bo'lsa: Asterisk promptlarni shu bazadan HTTP orqali oladi
# (odatda SITE_DOMAIN bilan bir xil). Bo'sh = o'chiq.
# AUDIO_MEDIA_BASE_URL=

# PBX'ga audio auto-push (sound: rejimida, admin panelda yuklaganda)
# PBX_SSH_HOST=
# PBX_SSH_USER=root
# PBX_SSH_PASSWORD=
# PBX_SSH_KEY=
# PBX_SOUNDS_DIR=/var/lib/asterisk/sounds/en

# Eskiz SMS
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_DRY_RUN=false

# Workers
RIVER_MAX_WORKERS=5
